# Required: Anthropic API key for extraction
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use. Defaults to claude-opus-4-8 for accuracy on legal docs.
# Switch to claude-sonnet-4-6 for cheaper/faster runs.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: shared password gate. If set, every request must include
# Basic auth (user: "extract", password: SITE_PASSWORD) or a matching cookie.
# Leave unset for a fully open demo.
SITE_PASSWORD=
