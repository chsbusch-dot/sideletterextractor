# Required: Anthropic API key for extraction
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use. Defaults to claude-opus-4-8 for accuracy on legal docs.
# Switch to claude-sonnet-4-6 for cheaper/faster runs.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: shared password gate. If set, every request must include
# Basic auth (user: "catalant", password: SITE_PASSWORD) or a matching cookie.
# Leave unset for a fully open demo.
SITE_PASSWORD=

# Optional: login logging + daily digest email.
# All four are required to make the digest fire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=re_...
LOGIN_DIGEST_TO=you@example.com
# Optional: override sender. Defaults to onboarding@resend.dev, which works without verifying a domain.
LOGIN_DIGEST_FROM="Side Letter Extractor <onboarding@resend.dev>"
# Optional: Vercel sets this automatically for cron requests if you set the value
# in Project Settings. Lets the cron route refuse non-cron callers.
CRON_SECRET=
